---
/**
 * MOLECULES — Tiles / MediaObject. Atoms only: Image placeholder, Button (tertiary).
 * Content max 1120px. Position=Left (image | text) and Position=Right (text | image).
 * Mobile: image top, text below. Mobile switch toggles .is-mobile.
 */
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const heading = 'Dornare eros dolor interdum nullaut';
const body = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat. Hac integer bibendum vulputate senectus mus vivamus curabitur cubilia!';
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">MediaObject — desktop / mobile<span class="vb-cap-id">#mediaobject</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <!-- Position = Left (image left, text right) -->
  <div class="vb-media vb-media--left">
    <div class="vb-media__media"><div class="vb-image" set:html={placeholder}></div></div>
    <div class="vb-media__content">
      <h3 class="vb-media__heading">{heading}</h3>
      <p class="vb-media__text">{body}</p>
      <a href="#" class="vb-btn vb-btn--tertiary">Button primary</a>
    </div>
  </div>

  <!-- Position = Right (text left, image right) -->
  <div class="vb-media vb-media--right">
    <div class="vb-media__media"><div class="vb-image" set:html={placeholder}></div></div>
    <div class="vb-media__content">
      <h3 class="vb-media__heading">{heading}</h3>
      <p class="vb-media__text">{body}</p>
      <a href="#" class="vb-btn vb-btn--tertiary">Button primary</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      if (!t) return;
      t.addEventListener('change', function () {
        tile.querySelectorAll('.vb-media, .vb-intro').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
      });
    });
  })();
</script>
