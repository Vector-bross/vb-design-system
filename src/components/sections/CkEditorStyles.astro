      <div class="vb-cta vb-rte__questions">
        <h3 class="vb-cta__title">Questions or comments?</h3>
        <p class="vb-cta__text">Elit nisi in eleifend sed nisiulvinar at orci, proin imperdiet commodo consectetur convallis risus. Sed condimentum enim <a href="#" class="vb-link">dignissim adipiscing</a></p>
        <div class="vb-cta__actions"><a href="#" class="vb-btn vb-btn--primary vb-btn--small">View more</a></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });

    // Gallery slider
    document.querySelectorAll('[data-gallery]').forEach(function (g) {
      var track = g.querySelector('[data-track]');
      var dots = g.querySelectorAll('[data-dot]');
      var n = track ? track.children.length : 0;
      var idx = 0;
      function go(i) {
        idx = (i + n) % n;
        if (track) track.style.transform = 'translateX(-' + (idx * 100) + '%)';
        dots.forEach(function (d, di) { d.classList.toggle('is-active', di === idx); });
      }
      g.querySelectorAll('[data-dir]').forEach(function (b) {
        b.addEventListener('click', function () { go(idx + (b.getAttribute('data-dir') === 'next' ? 1 : -1)); });
      });
      dots.forEach(function (d, di) { d.addEventListener('click', function () { go(di); }); });
      go(0);
    });

    // Testimonial slider
    document.querySelectorAll('[data-quote]').forEach(function (q) {
      var list; try { list = JSON.parse(q.getAttribute('data-quotes')); } catch (e) { return; }
      if (!list || !list.length) return;
      var textEl = q.querySelector('[data-quote-text]');
      var nameEl = q.querySelector('[data-quote-name]');
      var roleEl = q.querySelector('[data-quote-role]');
      var idx = 0;
      function go(i) {
        idx = (i + list.length) % list.length;
        if (textEl) { textEl.style.opacity = '0'; }
        setTimeout(function () {
          if (textEl) { textEl.textContent = list[idx].text; textEl.style.opacity = '1'; }
          if (nameEl) nameEl.textContent = list[idx].name;
          if (roleEl) roleEl.textContent = list[idx].role;
        }, 150);
      }
      q.querySelectorAll('[data-dir]').forEach(function (b) {
        b.addEventListener('click', function () { go(idx + (b.getAttribute('data-dir') === 'next' ? 1 : -1)); });
      });
    });
  })();
</script>
