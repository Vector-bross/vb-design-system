---
/**
 * MOLECULES — Tiles / Quote (testimonial slider). Tokens only, atoms.
 * Full-bleed grey band (100vw), content 928px. Arrows cycle several quotes.
 */
import arrow from '../../assets/icons/arrow-right.svg?raw';
const avatarIcon = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const quotes = [
  { text: '“Ultrices neque ipsum suspendisse lorem gravida dictum fusce placerat orcivitae cmauris rhoncus aenean lorem ipsum dolorsitamet”', name: 'Firstname Lastname', role: 'Function, company name' },
  { text: '“Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas vestibulum tortor quam feugiat vitae”', name: 'Amelia Durand', role: 'Head of design, Vela' },
  { text: '“Curabitur blandit tempus porttitor integer posuere erat a ante venenatis dapibus posuere velit aliquet nullam quis risus eget”', name: 'Marc Lefèvre', role: 'CTO, Northwind' },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Quote / Testimonial — desktop / mobile<span class="vb-cap-id">#quote</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-quote-band">
    <blockquote class="vb-quote" data-quotes={JSON.stringify(quotes)}>
      <p class="vb-quote__text" data-quote-text>{quotes[0].text}</p>
      <div class="vb-quote__author">
        <div class="vb-quote__who">
          <span class="vb-quote__avatar" set:html={avatarIcon}></span>
          <div>
            <div class="vb-quote__name" data-quote-name>{quotes[0].name}</div>
            <div class="vb-quote__role" data-quote-role>{quotes[0].role}</div>
          </div>
        </div>
        <div class="vb-quote__arrows">
          <button type="button" class="vb-icon-btn vb-icon-btn--flip" data-dir="prev" aria-label="Previous" set:html={arrow}></button>
          <button type="button" class="vb-icon-btn" data-dir="next" aria-label="Next" set:html={arrow}></button>
        </div>
      </div>
    </blockquote>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      if (t && !t.dataset.bound) {
        t.dataset.bound = '1';
        t.addEventListener('change', function () {
          tile.querySelectorAll('.vb-media, .vb-intro, .vb-textlist, .vb-gallery, .vb-numlist, .vb-table-wrap, .vb-accordion, .vb-quote').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
        });
      }
    });
    document.querySelectorAll('[data-quotes]').forEach(function (q) {
      var list; try { list = JSON.parse(q.getAttribute('data-quotes')); } catch (e) { return; }
      if (!list || !list.length) return;
      var textEl = q.querySelector('[data-quote-text]');
      var nameEl = q.querySelector('[data-quote-name]');
      var roleEl = q.querySelector('[data-quote-role]');
      var idx = 0;
      function go(i) {
        idx = (i + list.length) % list.length;
        if (textEl) textEl.style.opacity = '0';
        setTimeout(function () {
          if (textEl) { textEl.textContent = list[idx].text; textEl.style.opacity = '1'; }
          if (nameEl) nameEl.textContent = list[idx].name;
          if (roleEl) roleEl.textContent = list[idx].role;
        }, 150);
      }
      q.querySelectorAll('[data-dir]').forEach(function (b) {
        b.addEventListener('click', function () { go(idx + (b.getAttribute('data-dir') === 'next' ? 1 : -1)); });
      });
    });
  })();
</script>
