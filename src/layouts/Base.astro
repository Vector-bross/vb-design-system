---
import '../styles/global.css';
interface Props { title?: string; }
const { title = 'Kickstart Theme' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="text-base-content antialiased" style="background: #e6e6e6;">
    <slot />
  </body>
</html>
