  'Posuere ornare leo metus, ultricies. Blandit duis ultricies vulputate mo',
];
const numbered = [
  { badge: n1, text: 'Dolor enim eu tortor urna sed duis nullaliquam vestibulum' },
  { badge: n2, text: 'Proin imperdiet commodo consectetur convallis risus' },
  { badge: n3, text: 'Dolor enim eu tortor urna sed duis nullaliquam vestibulum' },
];
const testimonials = [
  { text: '“Ultrices neque ipsum suspendisse lorem gravida dictum fusce placerat orcivitae cmauris rhoncus aenean lorem ipsum dolorsitamet”', name: 'Firstname Lastname', role: 'Function, company name' },
  { text: '“Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas vestibulum tortor quam feugiat vitae”', name: 'Amelia Durand', role: 'Head of design, Vela' },
  { text: '“Curabitur blandit tempus porttitor integer posuere erat a ante venenatis dapibus posuere velit aliquet nullam quis risus eget”', name: 'Marc Lefèvre', role: 'CTO, Northwind' },
];
const rows = [
  ['Idleo in vitae turpis massa', 'Idleo in vitae turpis massa', '00'],
  ['Massa sed elementum tempus egest', 'Massa sed elementum tempus egest', '00'],
  ['Idleo in vitae turpis massa', 'Idleo in vitae turpis massa', '00'],
  ['Massa sed elementum tempus egest', 'Massa sed elementum tempus egest', '00'],
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">CKEditor styles — rich text</span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>

  <div class="vb-rte" data-sec>
    <div class="vb-rte__inner">
