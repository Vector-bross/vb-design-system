---
/**
 * ORGANISMS · Page section — ServicesSection ("Our services"). Composes the
 * existing horizontal Card molecule stacked in a list. White band, View all.
 */
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const desc = 'Pulvinar vivamus fringilla lacus nec metus bibendum egestas. Iaculis massa nisl malesuada lacinia integer nunc posuere. Ut hendrerit semper vel cla ...';
const rows = [1, 2, 3, 4];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Services section — desktop / mobile<span class="vb-cap-id">#services-section</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>
  <div class="vb-sec-band vb-sec-band--white">
    <div class="vb-sec" data-sec>
      <p class="vb-sec__title">Our services</p>
      <div class="vb-sec__list">
        {rows.map(() => (
          <article class="vb-card-h">
            <div class="vb-card-h__media"><div class="vb-image" set:html={placeholder}></div></div>
            <div class="vb-card-h__content">
              <div class="vb-card-h__body">
                <h3 class="vb-card-h__title">Service name</h3>
                <p class="vb-card-h__desc">{desc}</p>
              </div>
              <a href="#" class="vb-btn vb-btn--tertiary">Read more</a>
            </div>
          </article>
        ))}
      </div>
      <div class="vb-sec__actions"><a href="#" class="vb-btn vb-btn--secondary">View all</a></div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () {
        sec.classList.toggle('is-mobile', t.checked);
        sec.querySelectorAll('.vb-card-h').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
      });
    });
  })();
</script>
