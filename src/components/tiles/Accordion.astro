---
/**
 * MOLECULES — Tiles / Accordion. Reuses the faqs +/- atom. Tokens only.
 * Question (Poppins SemiBold 20 #000) + faq toggle; answer (Inter Light 16 #444).
 * Interactive: native checkbox opens/closes each item and swaps + / −.
 */
const q = 'Imperdietunc ut sem vitae risus tristique posuer?';
const a = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla, ut commodo diam libero vitae erat. Aenean faucibus nibh et justo cursus id rutrum lorem imperdiet. Nunc ut sem vitae risus tristique posuere.';
const items = [
  { id: 'acc-1', open: true },
  { id: 'acc-2', open: false },
];
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Accordion — desktop / mobile<span class="vb-cap-id">#accordion</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>
  <div class="vb-accordion">
    {items.map((it) => (
      <div class="vb-accordion__item">
        <input type="checkbox" class="vb-accordion__toggle" id={it.id} checked={it.open} />
        <label class="vb-accordion__q" for={it.id}>
          <span class="vb-accordion__title">{q}</span>
          <span class="vb-faq" aria-hidden="true"></span>
        </label>
        <div class="vb-accordion__a"><p class="vb-accordion__text">{a}</p></div>
      </div>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      if (!t || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () {
        tile.querySelectorAll('.vb-media, .vb-intro, .vb-textlist, .vb-gallery, .vb-numlist, .vb-table-wrap, .vb-accordion').forEach(function (el) { el.classList.toggle('is-mobile', t.checked); });
      });
    });
  })();
</script>
