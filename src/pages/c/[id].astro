---
import PortalShell from '../../layouts/PortalShell.astro';
import { registry, byId, categories } from '../../registry';
import { catalog, cleanSource } from '../../lib/catalog';

export function getStaticPaths() {
  return registry.map((e) => ({ params: { id: e.id } }));
}
const { id } = Astro.params as { id: string };
const entry = byId(id)!;
const cat = categories.find((c) => c.id === entry.category);
const src = cleanSource(catalog[id]?.src ?? '');
const srcJson = JSON.stringify(src).replace(/</g, '\\u003c');
const Comp = catalog[id]?.Component;
const fileName = `${entry.name.replace(/[^A-Za-z0-9]/g, '')}.astro`;
const srcPath = `src/components/${entry.atomicLevel === 'section' ? 'sections' : 'organisms'}/${fileName}`;
---
<PortalShell title={`${entry.name} — Kickstart Theme`} active="home" base="../">
  <p class="vb-detail__crumb"><a href="../index.html">Library</a> <span>›</span> {cat?.label} <span>›</span> {entry.name}</p>
  <div class="vb-cd__top">
    <h1 class="vb-detail__title">{entry.name}</h1>
    <span class="vb-libcard__id">#{entry.id}</span>
    <div class="vb-cd__actions">
      <button class="vb-icnbtn" data-copylink aria-label="Copy link" title="Copy link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
      </button>
      <a class="vb-icnbtn" href={`../preview/${id}.html`} target="_blank" rel="noopener" aria-label="Open preview" title="Open preview">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      </a>
      <button class="vb-btnprimary" data-download data-filename={fileName}>Export .astro ↓</button>
    </div>
  </div>

  <div class="vb-cd">
    <div class="vb-cd__main">
      <input type="checkbox" id="vb-stage-mobile" class="vb-stage-mobile-cb" data-stage-mobile />
      <div class="vb-cd__bar">
        <label class="vb-cd__mobile" for="vb-stage-mobile"><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
      </div>
      <div class="vb-detail__stage" data-stage>
        <a class="vb-detail__stageopen" href={`../preview/${id}.html`} target="_blank" rel="noopener" aria-label="Open full preview in a new tab"><span>Open full preview ↗</span></a>
        <div class="vb-detail__stageinner" data-stageinner>{Comp && <Comp />}</div>
      </div>

      <script type="application/json" id="vb-code-src" set:html={srcJson}></script>
    </div>

    <aside class="vb-cd__aside">
      <section class="vb-cinfo">
        <h2 class="vb-cinfo__title">Details</h2>
        <div class="vb-cinfo__row"><dt>Category</dt><dd>{cat?.label}</dd></div>
        <div class="vb-cinfo__row"><dt>Atomic level</dt><dd style="text-transform:capitalize">{entry.atomicLevel}</dd></div>
        <div class="vb-cinfo__row"><dt>Status</dt><dd>{entry.status === 'beta' ? 'Beta' : 'Ready'}</dd></div>
        {entry.deps && entry.deps.length > 0 && (
          <div class="vb-cinfo__row"><dt>Built from</dt><dd>{entry.deps.join(', ')}</dd></div>
        )}
      </section>

      <section class="vb-cinfo">
        <h2 class="vb-cinfo__title">Usage</h2>
        <p class="vb-cinfo__text">{entry.usage ?? entry.description}</p>
      </section>

      <section class="vb-cinfo">
        <h2 class="vb-cinfo__title">Export &amp; resources</h2>
        <button class="vb-cres" data-download data-filename={fileName}>
          <span class="vb-cres__icn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12"/><path d="m7 12 5 5 5-5"/><path d="M5 21h14"/></svg></span>
          <span class="vb-cres__text"><span class="vb-cres__t">Export code</span><span class="vb-cres__s">Download the .astro file</span></span>
          <span class="vb-cres__chev">↓</span>
        </button>
        <button class="vb-cres" data-copy>
          <span class="vb-cres__icn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></span>
          <span class="vb-cres__text"><span class="vb-cres__t">Copy code</span><span class="vb-cres__s">Copy to clipboard</span></span>
          <span class="vb-cres__chev">⧉</span>
        </button>
        <a class="vb-cres" href={entry.figma ?? '#'} target="_blank" rel="noopener" aria-disabled={entry.figma ? undefined : 'true'}>
          <span class="vb-cres__icn"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><circle cx="17.5" cy="17.5" r="3.5"/></svg></span>
          <span class="vb-cres__text"><span class="vb-cres__t">Figma</span><span class="vb-cres__s">{entry.figma ? 'Open the source node' : 'Link not set yet'}</span></span>
          <span class="vb-cres__chev">›</span>
        </a>
      </section>
    </aside>
  </div>

  <script is:inline>
    (function () {
      var stage = document.querySelector('[data-stage]');
      var inner = document.querySelector('[data-stageinner]');
      var stageMobile = document.querySelector('[data-stage-mobile]');
      var isMobileView = function () { return (stageMobile && stageMobile.checked) || (stage && stage.classList.contains('is-mobile-view')); };
      if (stage && inner) {
        var fit = function () {
          if (isMobileView()) {
            inner.style.transform = 'none';
            stage.style.height = '';
          } else {
            var s = stage.clientWidth / 1280;
            inner.style.transform = 'scale(' + s + ')';
            stage.style.height = (inner.offsetHeight * s) + 'px';
          }
        };
        fit();
        window.addEventListener('load', fit);
        window.addEventListener('resize', fit);
        if (window.ResizeObserver) { try { new ResizeObserver(fit).observe(inner); } catch (e) {} }
      }

      var codeText = '';
      try { codeText = JSON.parse(document.getElementById('vb-code-src').textContent || '""'); } catch (e) {}
      function flash(btn, label) {
        var span = btn.querySelector('span') || btn;
        var t = span.textContent; span.textContent = label;
        setTimeout(function () { span.textContent = t; }, 1500);
      }
      document.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          navigator.clipboard.writeText(codeText).then(function () { flash(btn, 'Copied ✓'); });
        });
      });
      function download(filename) {
        var blob = new Blob([codeText], { type: 'text/plain;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = filename || 'component.astro';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      }
      document.querySelectorAll('[data-download]').forEach(function (btn) {
        btn.addEventListener('click', function () { download(btn.getAttribute('data-filename')); });
      });
      var linkBtn = document.querySelector('[data-copylink]');
      if (linkBtn) linkBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(function () { linkBtn.classList.add('is-done'); setTimeout(function () { linkBtn.classList.remove('is-done'); }, 1200); });
      });

      // Single Mobile switch in the toolbar drives every variant's built-in toggle.
      var stageMobile = document.querySelector('[data-stage-mobile]');
      if (stageMobile && inner) {
        stageMobile.addEventListener('change', function () {
          if (stage) stage.classList.toggle('is-mobile-view', stageMobile.checked);
          inner.querySelectorAll('[data-mobile-toggle]').forEach(function (cb) {
            if (cb.checked !== stageMobile.checked) {
              cb.checked = stageMobile.checked;
              cb.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
          if (typeof fit === 'function') setTimeout(fit, 50);
        });
      }
    })();
  </script>
</PortalShell>
