---
/**
 * ORGANISMS · Page section — StatsSection ("Key numbers"). Stat cards (big
 * number display-1) + images in 3 columns. bg-body band. Atoms + tokens only.
 */
const placeholder = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const statText = 'Lorem ipsum dolor sit amet, consectetur adipiscin';
---
<div class="flex flex-col gap-4" data-tile>
  <div class="flex items-center justify-between rounded-box border border-base-300 bg-base-100 p-4">
    <span class="text-sm font-medium uppercase tracking-wide text-base-content/60">Stats section — desktop / mobile<span class="vb-cap-id">#stats-section</span></span>
    <label class="vb-control"><input type="checkbox" data-mobile-toggle /><span class="vb-toggle__track"><span class="vb-toggle__thumb"></span></span>Mobile</label>
  </div>
  <div class="vb-sec-band vb-sec-band--body">
    <div class="vb-sec">
      <p class="vb-sec__title">Key numbers</p>
      <div class="vb-stats" data-sec>
        <div class="vb-stats__col">
          <div class="vb-stat"><p class="vb-stat__text">{statText}</p><p class="vb-stat__num">5M</p></div>
          <div class="vb-stats__img"><div class="vb-image" set:html={placeholder}></div></div>
        </div>
        <div class="vb-stats__col">
          <div class="vb-stats__img vb-stats__img--wide"><div class="vb-image" set:html={placeholder}></div></div>
          <div class="vb-stat"><p class="vb-stat__text">{statText}</p><p class="vb-stat__num">20%</p></div>
        </div>
        <div class="vb-stats__col">
          <div class="vb-stat"><p class="vb-stat__text">{statText}</p><p class="vb-stat__num">30%</p></div>
          <div class="vb-stats__img"><div class="vb-image" set:html={placeholder}></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-tile]').forEach(function (tile) {
      var t = tile.querySelector('[data-mobile-toggle]');
      var sec = tile.querySelector('[data-sec]');
      if (!t || !sec || t.dataset.bound) return;
      t.dataset.bound = '1';
      t.addEventListener('change', function () { sec.classList.toggle('is-mobile', t.checked); });
    });
  })();
</script>
