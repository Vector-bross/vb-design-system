---
import PortalShell from '../layouts/PortalShell.astro';
import ControlsShowcase from '../components/ControlsShowcase.astro';
import FieldsShowcase from '../components/FieldsShowcase.astro';
import FormsShowcase from '../components/FormsShowcase.astro';
import IntroBanner from '../components/tiles/IntroBanner.astro';
import MediaObject from '../components/tiles/MediaObject.astro';
import TextList from '../components/tiles/TextList.astro';
import Gallery from '../components/tiles/Gallery.astro';
import NumberedList from '../components/tiles/NumberedList.astro';
import Table from '../components/tiles/Table.astro';
import Accordion from '../components/tiles/Accordion.astro';
import Quote from '../components/tiles/Quote.astro';
import CardsShowcase from '../components/CardsShowcase.astro';
import EmptyState from '../components/EmptyState.astro';
---
<PortalShell title="Molecules — Kickstart Theme" active="molecules">

  <div class="vb-lib__head">
    <h1 class="vb-lib__title">Molecules</h1>
  </div>

  <div class="flex flex-col gap-12">
    

    <section id="controls" class="scroll-mt-28">
      <div class="flex flex-col gap-6 rounded border border-base-300 bg-base-100 p-8">
        <h2 class="text-3xl font-semibold tracking-tight">Controls</h2>
        <ControlsShowcase />
      </div>
    </section>

    <section id="fields" class="scroll-mt-28">
      <div class="flex flex-col gap-6 rounded border border-base-300 bg-base-100 p-8">
        <h2 class="text-3xl font-semibold tracking-tight">Fields</h2>
        <FieldsShowcase />
      </div>
    </section>

    <section id="forms" class="scroll-mt-28">
      <div class="flex flex-col gap-6 rounded border border-base-300 bg-base-100 p-8">
        <h2 class="text-3xl font-semibold tracking-tight">Forms controls</h2>
        <FormsShowcase />
      </div>
    </section>

    <section id="tiles" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Tiles</h2>
      <IntroBanner />
      <MediaObject />
      <TextList />
      <Gallery />
      <NumberedList />
      <Table />
      <Accordion />
      <Quote />
    </section>

    <section id="cards" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Cards &amp; CTA</h2>
      <CardsShowcase />
    </section>

    <section id="empty" class="scroll-mt-28 flex flex-col gap-6">
      <h2 class="text-3xl font-semibold tracking-tight">Empty state</h2>
      <EmptyState />
    </section>
  </div>
</PortalShell>
